:root {
    --color-primary: #111111;
    --color-primary-dark: #000000;
    --color-danger: #d92d20;
    --color-success: #067647;
    --color-warning: #b54708;
    --color-bg: #ffffff;
    --color-surface: #f7f7f7;
    --color-card: #ffffff;
    --color-border: #e8e8e8;
    --color-border-strong: #d6d6d6;
    --color-text: #151515;
    --color-muted: #737373;
    --color-subtle: #a3a3a3;
    --radius: 12px;
    --radius-sm: 9px;
    --shadow-float: 0 10px 30px rgba(0,0,0,.06);
}

* { box-sizing: border-box; }
html {
    color-scheme: light;
    min-height: 100%;
}
body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
}

a { color: inherit; text-decoration: none; }
a:hover { text-decoration: none; }
button, input, textarea, select { font: inherit; }

/* Global header — intentionally quiet and product-like */
.topbar {
    background: rgba(255,255,255,.94);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(12px);
}
.topbar-inner {
    max-width: 1200px;
    min-height: 64px;
    margin: 0 auto;
    padding: 0 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}
.brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.02em;
    color: var(--color-text);
    white-space: nowrap;
}
.brand-mark {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    display: inline-grid;
    place-items: center;
    background: #111;
    color: #fff;
    font-size: .72rem;
    letter-spacing: -.03em;
}
.nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
}
.nav-links a {
    position: relative;
    padding: 8px 10px;
    border-radius: 8px;
    color: #555;
    font-size: .88rem;
    font-weight: 500;
    transition: background .15s ease, color .15s ease;
}
.nav-links a:hover { background: var(--color-surface); color: var(--color-text); }
.nav-links .nav-cta { background: #111; color: #fff; margin-left: 4px; }
.nav-links .nav-cta:hover { background: #2a2a2a; color: #fff; }
.pill {
    min-width: 18px;
    height: 18px;
    display: inline-grid;
    place-items: center;
    background: #111;
    color: #fff;
    font-size: .65rem;
    font-weight: 700;
    padding: 0 5px;
    border-radius: 99px;
    margin-left: 3px;
}

.page {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 38px 28px 72px;
    flex: 1 0 auto;
}
.page-title { margin: 0 0 6px; font-size: 1.8rem; letter-spacing: -.04em; line-height: 1.2; }
.page-subtitle { margin: 0; color: var(--color-muted); font-size: .94rem; }

.flash {
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    margin-bottom: 20px;
    font-size: .9rem;
}
.flash-success { background: #f3fbf6; color: #066a42; border-color: #ccebd9; }
.flash-error { background: #fff5f5; color: #a5221a; border-color: #f4d0cd; }
.flash ul { margin: 0; padding-left: 18px; }

/* Forms */
.auth-card, .form-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 32px;
    max-width: 560px;
    margin: 28px auto 0;
    box-shadow: 0 1px 2px rgba(0,0,0,.02);
}
.auth-card { max-width: 430px; }
.auth-card h1, .form-card h1, .post-detail h1, .inbox-list h1, .conversation h1,
.notifications-list h1, .admin-panel h1 {
    margin: 0 0 24px;
    font-size: 1.55rem;
    line-height: 1.25;
    letter-spacing: -.035em;
}
.auth-card p { color: var(--color-muted); font-size: .88rem; }
.auth-card p a { color: var(--color-text); font-weight: 600; }

label {
    display: block;
    margin-bottom: 18px;
    color: #404040;
    font-weight: 600;
    font-size: .84rem;
}
input, select, textarea {
    display: block;
    width: 100%;
    margin-top: 7px;
    padding: 10px 12px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--color-text);
    font-size: .9rem;
    outline: none;
    transition: border-color .15s ease, box-shadow .15s ease;
}
input::placeholder, textarea::placeholder { color: #a8a8a8; }
input:focus, select:focus, textarea:focus {
    border-color: #777;
    box-shadow: 0 0 0 3px rgba(0,0,0,.06);
}
textarea { resize: vertical; min-height: 110px; }
input[type="file"] { padding: 8px; background: #fafafa; }
.checkbox-label { display: flex; align-items: flex-start; gap: 9px; font-weight: 500; color: #555; }
.checkbox-label input { width: auto; margin: 3px 0 0; }
.field-row { display: flex; gap: 14px; }
.field-row label { flex: 1; }
.type-toggle {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 22px;
}
.type-toggle label {
    margin: 0;
    padding: 12px;
    display: flex;
    gap: 8px;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    cursor: pointer;
    font-weight: 600;
}
.type-toggle input { width: auto; margin: 0; }

.btn {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 9px;
    border: 1px solid var(--color-border-strong);
    background: #fff;
    color: var(--color-text);
    cursor: pointer;
    font-size: .86rem;
    font-weight: 650;
    line-height: 1;
    transition: background .15s ease, border-color .15s ease, transform .08s ease;
}
.btn:hover { background: #f7f7f7; border-color: #c9c9c9; }
.btn:active { transform: translateY(1px); }
.btn-primary { background: #111; border-color: #111; color: #fff; }
.btn-primary:hover { background: #292929; border-color: #292929; }
.btn-danger { background: #fff; border-color: #efc3bf; color: var(--color-danger); }
.btn-danger:hover { background: #fff5f4; }
.btn-sm { min-height: 30px; padding: 6px 10px; font-size: .78rem; border-radius: 7px; }

/* Feed */
.feed-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
}

.feed-header-simple {
    justify-content: flex-start;
    margin-bottom: 18px;
}
.feed-header h1 { margin: 0 0 5px; font-size: 1.8rem; letter-spacing: -.04em; }
.feed-header p { margin: 0; color: var(--color-muted); font-size: .92rem; }
.feed-layout { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 30px; }
.filters-panel {
    align-self: start;
    position: sticky;
    top: 88px;
    padding-right: 6px;
}
.filters-panel h2 {
    margin: 0 0 18px;
    font-size: .82rem;
    color: var(--color-muted);
    font-weight: 650;
    letter-spacing: .02em;
    text-transform: uppercase;
}
.filters-panel label { margin-bottom: 14px; font-size: .78rem; color: #606060; }
.filters-panel input, .filters-panel select { padding: 9px 10px; font-size: .84rem; background: #fafafa; }
.feed-panel { min-width: 0; }
#feed-status { min-height: 24px; margin-bottom: 10px; font-size: .82rem; }
.post-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.post-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    min-width: 0;
    transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
}
.post-card:hover {
    border-color: #d0d0d0;
    box-shadow: 0 8px 24px rgba(0,0,0,.055);
    transform: translateY(-1px);
}
.post-card-photo {
    height: 170px;
    background-size: cover;
    background-position: center;
    background-color: #f2f2f2;
    border-bottom: 1px solid var(--color-border);
}
.post-card-body { padding: 14px 15px 16px; }
.post-card-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 11px; }
.post-card-title { margin: 0 0 7px; font-size: .98rem; line-height: 1.3; letter-spacing: -.015em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.post-card-meta { margin: 0 0 7px; font-size: .77rem; color: var(--color-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.post-card-desc {
    margin: 0;
    color: var(--color-muted);
    font-size: .81rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.type-tag, .badge, .status-tag {
    display: inline-flex;
    align-items: center;
    min-height: 22px;
    padding: 3px 8px;
    border-radius: 999px;
    font-size: .68rem;
    font-weight: 700;
    line-height: 1;
    border: 1px solid #e5e5e5;
    background: #f7f7f7;
    color: #555;
}
.type-tag { text-transform: capitalize; }
.type-tag.type-lost { background: #fff4f3; color: #a52a22; border-color: #f3d2cf; }
.type-tag:not(.type-lost) { background: #f2faf5; color: #1a6b46; border-color: #d4eadc; }
.badge-open { background: #f5f5f5; color: #555; }
.badge-claimed, .badge-pending { background: #fff9eb; color: #8a5b13; border-color: #efe1bb; }
.badge-resolved { background: #f2faf5; color: #17643f; border-color: #d4eadc; }
.badge-rejected, .badge-highvalue { background: #fff4f3; color: #a52a22; border-color: #f3d2cf; }

.pagination { display: flex; gap: 6px; margin-top: 26px; justify-content: center; }
.pagination button { min-width: 34px; height: 34px; padding: 0 9px; border-radius: 8px; border: 1px solid var(--color-border); background: #fff; color: #555; cursor: pointer; }
.pagination button:hover { background: #f7f7f7; }
.pagination button.active { background: #111; color: #fff; border-color: #111; }

/* Post detail */
.post-detail {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 32px;
    max-width: 820px;
    margin: 12px auto 0;
}
.post-detail-header { display: flex; gap: 8px; margin-bottom: 12px; }
.post-photo { width: 100%; max-height: 460px; object-fit: cover; border-radius: 12px; margin: 12px 0 8px; border: 1px solid var(--color-border); }
.post-photo-thumb { max-width: 200px; border-radius: 10px; border: 1px solid var(--color-border); }
.post-description { color: #454545; }
.post-meta { display: grid; grid-template-columns: 120px 1fr; gap: 9px 14px; margin: 22px 0; padding: 18px 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); font-size: .88rem; }
.post-meta dt { color: var(--color-muted); font-weight: 500; }
.post-meta dd { margin: 0; font-weight: 550; }
.action-bar { display: flex; gap: 8px; margin: 18px 0; flex-wrap: wrap; }
.claims-section, .comments-section { margin-top: 30px; border-top: 1px solid var(--color-border); padding-top: 24px; }
.claims-section h2, .comments-section h2 { font-size: 1.08rem; letter-spacing: -.02em; }
.claim-card { background: #fafafa; border: 1px solid var(--color-border); border-radius: 10px; padding: 14px; margin-bottom: 10px; }
.claim-card-top { display: flex; gap: 9px; align-items: center; margin-bottom: 7px; }
.comment { padding: 11px 0; border-bottom: 1px solid var(--color-border); font-size: .88rem; }

/* Messages and notifications */
.inbox-list, .conversation, .notifications-list {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 28px;
    max-width: 760px;
    margin: 12px auto 0;
}
.conversation-row, .notification-row {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 14px 8px;
    margin: 0 -8px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    border-radius: 8px;
}
.conversation-row:hover, .notification-row:hover { background: #fafafa; }
.conversation-row.unread { font-weight: 700; }
.message-thread { display: flex; flex-direction: column; gap: 9px; margin: 18px 0; max-height: 480px; overflow-y: auto; padding: 4px; }
.message-bubble { max-width: 72%; padding: 10px 13px; border-radius: 13px; font-size: .87rem; }
.message-bubble.mine { align-self: flex-end; background: #111; color: #fff; border-bottom-right-radius: 4px; }
.message-bubble.theirs { align-self: flex-start; background: #f2f2f2; border-bottom-left-radius: 4px; }
.message-bubble .time { display: block; font-size: .66rem; opacity: .6; margin-top: 5px; color: inherit; }

/* Admin */
.admin-topbar { background: #111; border-bottom-color: #111; }
.admin-topbar .brand, .admin-topbar .nav-links a, .admin-topbar .nav-links span.muted { color: #e7e7e7; }
.admin-topbar .brand-mark { background: #fff; color: #111; }
.admin-topbar .nav-links a:hover { background: #262626; color: #fff; }
.admin-panel { background: var(--color-card); border: 1px solid var(--color-border); border-radius: 16px; padding: 28px; }
.admin-nav { display: flex; gap: 4px; margin: 12px 0 24px; border-bottom: 1px solid var(--color-border); padding-bottom: 10px; flex-wrap: wrap; }
.admin-nav a { padding: 7px 9px; border-radius: 7px; color: #666; font-size: .85rem; }
.admin-nav a:hover { background: #f7f7f7; }
.admin-nav a.active { background: #f2f2f2; color: #111; font-weight: 700; }
.stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 26px; }
.stat-card { background: #fafafa; border: 1px solid var(--color-border); border-radius: 11px; padding: 18px; text-align: left; }
.stat-card.highlight { background: #fff9ed; }
.stat-value { display: block; font-size: 1.65rem; font-weight: 700; letter-spacing: -.04em; }
.stat-label { font-size: .76rem; color: var(--color-muted); }
.admin-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
.admin-table th, .admin-table td { text-align: left; padding: 11px 10px; border-bottom: 1px solid var(--color-border); font-size: .84rem; }
.admin-table th { color: var(--color-muted); font-weight: 600; background: #fafafa; }
.inline-form { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; }
.inline-form label { margin-bottom: 0; }

.muted { color: var(--color-muted); }
.site-footer {
    width: 100%;
    max-width: 1200px;
    margin: auto auto 0;
    border-top: 1px solid var(--color-border);
    padding: 24px 28px 34px;
    color: var(--color-muted);
    font-size: .78rem;
}
.site-footer p { margin: 0; }

/* Landing page */
.landing-hero {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
    padding: 100px 20px 116px;
}
.landing-eyebrow {
    display: inline-flex;
    align-items: center;
    padding: 6px 10px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: #fafafa;
    color: #666;
    font-size: .76rem;
    font-weight: 600;
    margin-bottom: 22px;
}
.landing-hero h1 {
    max-width: 720px;
    margin: 0 auto 18px;
    font-size: clamp(2.7rem, 6vw, 4.7rem);
    line-height: .98;
    letter-spacing: -.065em;
}
.landing-hero > p { max-width: 620px; margin: 0 auto 28px; font-size: 1rem; line-height: 1.65; }
.landing-actions { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; }
.landing-actions .btn { min-height: 42px; padding-inline: 18px; }

@media (max-width: 980px) {
    .post-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 800px) {
    .topbar-inner { padding: 0 18px; min-height: 58px; }
    .nav-links { gap: 2px; }
    .nav-links a { padding: 7px 8px; font-size: .82rem; }
    .page { padding: 26px 18px 56px; }
    .feed-layout { grid-template-columns: 1fr; gap: 18px; }
    .filters-panel { position: static; padding: 16px; border: 1px solid var(--color-border); border-radius: 12px; background: #fafafa; }
    .filters-panel h2 { margin-bottom: 12px; }
    .filters-panel form { display: grid; grid-template-columns: 1fr 1fr; gap: 0 12px; }
    .filters-panel .field-row { grid-column: 1 / -1; }
    .field-row { flex-direction: column; gap: 0; }
    .landing-hero { padding: 72px 8px 84px; }
}
@media (max-width: 600px) {
    .topbar-inner { align-items: flex-start; padding-top: 12px; padding-bottom: 12px; }
    .brand .brand-text { display: none; }
    .nav-links { justify-content: flex-end; }
    .nav-links a { font-size: .76rem; padding: 6px 7px; }
    .nav-links .nav-cta { font-size: .76rem; padding-inline: 9px; }
    .post-grid { grid-template-columns: 1fr; }
    .post-card-photo { height: 210px; }
    .filters-panel form { grid-template-columns: 1fr; }
    .filters-panel .field-row { grid-column: auto; }
    .auth-card, .form-card, .post-detail, .inbox-list, .conversation, .notifications-list, .admin-panel { padding: 22px; border-radius: 13px; }
    .feed-header { align-items: flex-start; flex-direction: column; }
    .type-toggle { grid-template-columns: 1fr; }
}

/* ============================================================
   2026 clean product UI refresh
   ============================================================ */
.page-public { max-width: none; padding: 0; }
.page-public > .flash { max-width: 1160px; margin: 20px auto; }
.public-nav { gap: 2px; }
.btn-lg { min-height: 46px; padding: 11px 18px; border-radius: 10px; font-size: .9rem; }
.text-link { font-size: .86rem; color: #555; font-weight: 650; }
.text-link:hover { color: #111; }
.section-kicker { text-transform: uppercase; letter-spacing: .12em; font-size: .68rem; color: #8a8a8a; font-weight: 750; }

.landing-shell { overflow: hidden; }
.landing-hero-split {
    max-width: 1160px;
    min-height: 620px;
    margin: 0 auto;
    padding: 78px 28px 86px;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(420px, .95fr);
    align-items: center;
    gap: 62px;
    text-align: left;
}
.landing-copy { position: relative; z-index: 2; }
.landing-hero-split .landing-eyebrow { margin-bottom: 20px; }
.landing-hero-split h1 {
    margin: 0 0 22px;
    max-width: 650px;
    font-size: clamp(3.2rem, 6.2vw, 5.4rem);
    line-height: .94;
    letter-spacing: -.072em;
}
.landing-lead { max-width: 590px; margin: 0 0 30px; font-size: 1.04rem; line-height: 1.7; color: #686868; }
.landing-actions-left { justify-content: flex-start; margin-bottom: 24px; }
.landing-trust { display: flex; gap: 18px; flex-wrap: wrap; color: #8a8a8a; font-size: .76rem; font-weight: 600; }

.landing-visual { height: 470px; position: relative; }
.visual-orbit { position: absolute; border-radius: 999px; border: 1px solid #ededed; }
.visual-orbit-one { inset: 36px 28px 26px 24px; }
.visual-orbit-two { inset: 96px 88px 86px 86px; }
.floating-item { position: absolute; border-radius: 18px; overflow: hidden; border: 1px solid #e4e4e4; box-shadow: 0 24px 60px rgba(0,0,0,.11); background: #f7f7f7; }
.floating-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
.floating-item-a { width: 190px; height: 218px; left: 32px; top: 48px; transform: rotate(-5deg); }
.floating-item-b { width: 166px; height: 154px; right: 20px; top: 8px; transform: rotate(4deg); }
.floating-item-c { width: 158px; height: 144px; right: 50px; bottom: 24px; transform: rotate(-3deg); }
.floating-item-d { width: 150px; height: 172px; left: 134px; bottom: 10px; transform: rotate(4deg); }

.landing-section { max-width: 1160px; margin: 0 auto; padding: 86px 28px; border-top: 1px solid #ededed; }
.landing-feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 24px; }
.landing-feature-grid article { padding: 26px 0 6px; border-top: 1px solid #dcdcdc; }
.feature-num { display: block; color: #aaa; font-size: .72rem; margin-bottom: 42px; font-weight: 700; }
.landing-feature-grid h2 { font-size: 1.15rem; margin: 0 0 8px; letter-spacing: -.03em; }
.landing-feature-grid p { margin: 0; color: #777; font-size: .88rem; max-width: 310px; }
.landing-section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 26px; }
.landing-section-head h2 { font-size: 1.9rem; margin: 6px 0 0; letter-spacing: -.045em; }
.public-card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.public-card { border: 1px solid #e7e7e7; border-radius: 14px; overflow: hidden; background: white; }
.public-card-image { height: 190px; background-size: cover; background-position: center; background-color: #f5f5f5; }
.public-card-body { padding: 14px; }
.public-card-body h3 { margin: 10px 0 4px; font-size: .95rem; }
.public-card-body p { margin: 0; color: #777; font-size: .78rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.landing-cta { max-width: 1104px; margin: 0 auto 86px; border-radius: 20px; background: #111; color: #fff; padding: 42px 44px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
.landing-cta .section-kicker { color: #aaa; }
.landing-cta h2 { margin: 6px 0 0; font-size: 2rem; letter-spacing: -.045em; }
.landing-cta .btn-primary { background: #fff; color: #111; border-color: #fff; }
.landing-cta .btn-primary:hover { background: #f2f2f2; }

/* Feed refinement */
.feed-header { align-items: center; }
.feed-header h1 { font-size: 2rem; }
.filters-panel { border: 1px solid #ececec; border-radius: 14px; padding: 18px; background: #fcfcfc; }
.filters-panel h2 { margin-bottom: 14px; }
.post-grid { gap: 18px; }
.post-card-photo { height: 190px; background-position: center; }
.post-card-body { padding: 15px 16px 17px; }
.post-card-title { font-size: 1rem; }
.post-card-desc { line-height: 1.55; }

/* Inbox */
.inbox-layout { max-width: 860px; margin: 12px auto 0; }
.inbox-list-wide { max-width: none; padding: 0; overflow: hidden; }
.panel-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; padding: 26px 26px 20px; border-bottom: 1px solid #ededed; }
.panel-heading h1 { margin: 5px 0 0; }
.conversation-list { display: block; }
.conversation-row { display: grid; grid-template-columns: 42px minmax(0,1fr) 10px; align-items: center; gap: 13px; padding: 17px 26px; margin: 0; border-radius: 0; }
.conversation-row:last-child { border-bottom: 0; }
.conversation-row:hover { background: #fafafa; }
.conversation-avatar { width: 42px; height: 42px; border-radius: 999px; display: grid; place-items: center; background: #111; color: white; font-weight: 750; font-size: .82rem; flex: 0 0 auto; }
.conversation-avatar.large { width: 38px; height: 38px; font-size: .78rem; }
.conversation-main { min-width: 0; }
.conversation-line { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
.conversation-line strong { font-size: .89rem; }
.conversation-line .time { font-size: .7rem; white-space: nowrap; }
.conversation-item { color: #555; font-size: .75rem; margin-top: 2px; font-weight: 650; }
.conversation-preview { display: block; color: #8a8a8a; font-size: .8rem; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 450; }
.unread-dot { width: 8px; height: 8px; border-radius: 999px; background: #111; }
.empty-state { text-align: center; padding: 70px 24px; }
.empty-icon { width: 44px; height: 44px; border-radius: 12px; border: 1px solid #e7e7e7; display: grid; place-items: center; margin: 0 auto 14px; }
.empty-state h2 { font-size: 1rem; margin: 0 0 6px; }
.empty-state p { color: #888; font-size: .84rem; margin: 0; }

/* Conversation */
.chat-shell { max-width: 820px; margin: 12px auto 0; background: #fff; border: 1px solid #e7e7e7; border-radius: 16px; overflow: hidden; }
.chat-topbar { min-height: 70px; padding: 14px 18px; display: flex; align-items: center; gap: 11px; border-bottom: 1px solid #ededed; }
.chat-back { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 8px; font-size: 1.1rem; color: #555; }
.chat-back:hover { background: #f4f4f4; }
.chat-person h1 { margin: 0; font-size: .92rem; letter-spacing: -.01em; }
.chat-person p { margin: 1px 0 0; color: #929292; font-size: .72rem; }
.chat-item-context { margin: 14px 16px 0; padding: 10px; background: #fafafa; border: 1px solid #ededed; border-radius: 11px; display: grid; grid-template-columns: 52px minmax(0,1fr) 24px; align-items: center; gap: 11px; }
.chat-item-context img { width: 52px; height: 52px; object-fit: cover; border-radius: 8px; }
.chat-item-context strong { display: block; font-size: .82rem; margin: 1px 0; }
.chat-item-context small { display: block; color: #888; font-size: .7rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.context-arrow { color: #999; }
.chat-shell .message-thread { height: 470px; max-height: 54vh; margin: 0; padding: 26px 20px; gap: 8px; background: #fff; }
.chat-shell .message-bubble { max-width: 68%; padding: 9px 12px; }
.chat-shell .message-bubble p { margin: 0; }
.chat-shell .message-bubble.mine { border-radius: 14px 14px 4px 14px; }
.chat-shell .message-bubble.theirs { border-radius: 14px 14px 14px 4px; background: #f2f2f2; }
.message-composer { padding: 12px 14px; border-top: 1px solid #ededed; display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 9px; align-items: end; }
.message-composer textarea { margin: 0; min-height: 42px; max-height: 110px; resize: none; background: #fafafa; }
.message-composer .btn { min-height: 42px; padding-inline: 18px; }
.chat-empty { margin: auto; color: #888; font-size: .84rem; }

/* General polish across remaining screens */
.auth-card, .form-card, .post-detail, .notifications-list, .admin-panel { box-shadow: 0 10px 30px rgba(0,0,0,.025); }
.form-card { max-width: 680px; }
.notifications-list { max-width: 820px; padding: 0; overflow: hidden; }
.notifications-list > h1 { padding: 26px 26px 18px; margin: 0; border-bottom: 1px solid #ededed; }
.notifications-list > .muted { padding: 22px 26px; display: block; }
.notification-row { margin: 0; padding: 16px 26px; border-radius: 0; }
.post-detail { max-width: 880px; }
.post-photo { aspect-ratio: 16/9; max-height: none; background: #f5f5f5; }
.site-footer { max-width: 1160px; }

@media (max-width: 900px) {
    .landing-hero-split { grid-template-columns: 1fr; min-height: auto; padding-top: 64px; }
    .landing-copy { text-align: center; }
    .landing-lead { margin-left: auto; margin-right: auto; }
    .landing-actions-left, .landing-trust { justify-content: center; }
    .landing-visual { max-width: 500px; width: 100%; margin: 0 auto; }
    .landing-feature-grid, .public-card-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 680px) {
    .topbar-inner { padding: 0 16px; }
    .brand-text { display: none; }
    .public-nav a:first-child { display: none; }
    .page { padding: 24px 16px 54px; }
    .page-public { padding: 0; }
    .landing-hero-split { padding: 54px 18px 62px; gap: 30px; }
    .landing-hero-split h1 { font-size: clamp(3rem, 14vw, 4.5rem); }
    .landing-visual { height: 360px; }
    .floating-item-a { width: 145px; height: 170px; left: 8px; }
    .floating-item-b { width: 132px; height: 120px; right: 4px; }
    .floating-item-c { width: 125px; height: 116px; right: 20px; }
    .floating-item-d { width: 120px; height: 140px; left: 92px; }
    .landing-section { padding: 62px 18px; }
    .landing-feature-grid, .public-card-grid { grid-template-columns: 1fr; }
    .feature-num { margin-bottom: 24px; }
    .landing-section-head, .landing-cta { align-items: flex-start; flex-direction: column; }
    .landing-cta { margin: 0 18px 62px; padding: 30px 26px; }
    .feed-layout { grid-template-columns: 1fr; }
    .filters-panel { position: static; }
    .post-grid { grid-template-columns: 1fr; }
    .conversation-row { padding-inline: 16px; }
    .panel-heading { padding-inline: 16px; }
    .chat-shell { border-radius: 12px; }
    .chat-shell .message-bubble { max-width: 82%; }
}

/* Horizontal feed search/filter bar */
.feed-toolbar {
    margin: 0 0 18px;
    padding: 0;
}
.feed-toolbar-main {
    display: grid;
    grid-template-columns: minmax(260px, 1.8fr) minmax(120px, .72fr) minmax(145px, .85fr) minmax(155px, .95fr) auto;
    gap: 10px;
    align-items: center;
}
.feed-toolbar-main select,
.feed-toolbar-main input,
.feed-toolbar-secondary select,
.advanced-filters select,
.advanced-filters input {
    width: 100%;
    min-height: 42px;
    margin: 0;
    border: 1px solid #e6e6e6;
    border-radius: 9px;
    background: #fff;
    color: #222;
    font-size: .82rem;
    box-shadow: none;
}
.feed-search {
    position: relative;
    margin: 0;
}
.feed-search input {
    padding-left: 36px;
}
.feed-search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    color: #8c8c8c;
    font-size: 1rem;
    pointer-events: none;
}
.toolbar-filter-btn {
    min-height: 42px;
    padding: 0 15px;
    border: 1px solid #e6e6e6;
    border-radius: 9px;
    background: #fff;
    color: #222;
    font: inherit;
    font-size: .82rem;
    font-weight: 650;
    cursor: pointer;
    white-space: nowrap;
}
.toolbar-filter-btn:hover,
.toolbar-filter-btn[aria-expanded="true"] { background: #f7f7f7; }
.feed-toolbar-secondary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 10px;
}
.category-chips {
    display: flex;
    gap: 7px;
    align-items: center;
    flex-wrap: wrap;
}
.category-chip {
    min-height: 30px;
    padding: 0 11px;
    border: 1px solid #e6e6e6;
    border-radius: 999px;
    background: #fff;
    color: #555;
    font: inherit;
    font-size: .72rem;
    font-weight: 600;
    cursor: pointer;
}
.category-chip:hover { border-color: #cfcfcf; }
.category-chip.active {
    background: #111;
    border-color: #111;
    color: #fff;
}
.feed-sort {
    width: auto !important;
    min-width: 118px;
    flex: 0 0 auto;
}
.advanced-filters {
    margin-top: 10px;
    padding: 14px;
    border: 1px solid #ececec;
    border-radius: 11px;
    background: #fafafa;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr auto;
    gap: 10px;
    align-items: end;
}
.advanced-filters[hidden] { display: none !important; }
.advanced-filters label {
    margin: 0;
    font-size: .72rem;
    color: #6f6f6f;
}
.advanced-filters label select,
.advanced-filters label input { margin-top: 5px; }
.feed-panel-full { width: 100%; }
.feed-status { min-height: 22px; margin: 0 0 10px; font-size: .78rem; }

@media (max-width: 980px) {
    .feed-toolbar-main {
        grid-template-columns: minmax(240px, 1.5fr) repeat(2, minmax(125px, .8fr)) auto;
    }
    .feed-toolbar-main #f-location { grid-column: 1 / -2; }
}
@media (max-width: 720px) {
    .feed-toolbar-main { grid-template-columns: 1fr 1fr; }
    .feed-search { grid-column: 1 / -1; }
    .feed-toolbar-main #f-location { grid-column: auto; }
    .toolbar-filter-btn { width: 100%; }
    .feed-toolbar-secondary { align-items: flex-start; flex-direction: column; }
    .feed-sort { width: 100% !important; }
    .advanced-filters { grid-template-columns: 1fr 1fr; }
    .advanced-filters .btn { width: 100%; }
}
@media (max-width: 480px) {
    .feed-toolbar-main,
    .advanced-filters { grid-template-columns: 1fr; }
    .feed-search { grid-column: auto; }
}

/* Category quick filters are links for a reliable no-JS fallback. */
a.category-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    line-height: 1;
}

/* Profile — identity, privacy and activity */
.profile-page { max-width: 1080px; margin: 8px auto 0; }
.profile-hero { display:flex; align-items:center; justify-content:space-between; gap:28px; padding:28px 0 30px; border-bottom:1px solid var(--color-border); }
.profile-identity { display:flex; align-items:center; gap:20px; min-width:0; }
.profile-avatar { width:92px; height:92px; border-radius:50%; object-fit:cover; border:1px solid var(--color-border); background:#f4f4f4; flex:0 0 auto; }
.profile-avatar.small { width:64px; height:64px; }
.profile-avatar-fallback { display:grid; place-items:center; background:#111; color:#fff; font-size:1.35rem; font-weight:750; letter-spacing:-.03em; }
.profile-avatar-fallback.small { font-size:1rem; }
.profile-title-block { min-width:0; }
.profile-name-line { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
.profile-name-line h1 { margin:0; font-size:2rem; letter-spacing:-.045em; }
.profile-title-block p { margin:6px 0 0; color:#505050; }
.verified-badge { display:inline-flex; align-items:center; gap:5px; border:1px solid #d9e9df; background:#f3faf6; color:#17643f; padding:5px 9px; border-radius:999px; font-size:.72rem; font-weight:700; }
.profile-actions { flex:0 0 auto; display:flex; gap:8px; }
.profile-layout { display:grid; grid-template-columns:300px minmax(0,1fr); gap:28px; padding-top:28px; }
.profile-about-card, .profile-edit-card { border:1px solid var(--color-border); background:#fff; border-radius:14px; padding:22px; }
.profile-about-card { align-self:start; }
.section-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:24px; margin-bottom:22px; }
.section-heading.compact { margin-bottom:14px; }
.section-heading h2 { margin:3px 0 0; font-size:1.18rem; letter-spacing:-.025em; }
.section-heading > p { margin:2px 0 0; color:var(--color-muted); font-size:.82rem; max-width:390px; }
.profile-details { margin:0; }
.profile-details > div { padding:12px 0; border-bottom:1px solid var(--color-border); }
.profile-details > div:last-child { border-bottom:0; }
.profile-details dt { color:var(--color-muted); font-size:.75rem; margin-bottom:4px; }
.profile-details dd { margin:0; font-size:.88rem; font-weight:600; overflow-wrap:anywhere; }
.private-note, .locked-note { font-size:.64rem; padding:2px 6px; border-radius:999px; margin-left:4px; vertical-align:middle; }
.private-note { background:#f4f4f4; color:#666; }
.locked-note { background:#fff7e8; color:#7d591c; }
.privacy-note { margin:18px 0 0; padding-top:16px; border-top:1px solid var(--color-border); color:var(--color-muted); font-size:.75rem; line-height:1.55; }
.profile-stats { display:grid; grid-template-columns:repeat(4,1fr); border:1px solid var(--color-border); border-radius:14px; overflow:hidden; margin-bottom:28px; }
.profile-stats div { padding:18px; border-right:1px solid var(--color-border); }
.profile-stats div:last-child { border-right:0; }
.profile-stats strong { display:block; font-size:1.35rem; letter-spacing:-.03em; }
.profile-stats span { color:var(--color-muted); font-size:.74rem; }
.profile-posts-heading { margin-bottom:14px; }
.profile-posts-heading h2 { margin:3px 0 0; font-size:1.2rem; letter-spacing:-.025em; }
.profile-post-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
.profile-post-card { display:grid; grid-template-columns:112px minmax(0,1fr); border:1px solid var(--color-border); border-radius:12px; overflow:hidden; color:var(--color-text); background:#fff; }
.profile-post-card:hover { border-color:#cfcfcf; }
.profile-post-image { min-height:112px; background:#f1f1f1 center/cover no-repeat; border-right:1px solid var(--color-border); }
.profile-post-body { padding:13px; min-width:0; }
.profile-post-body h3 { margin:8px 0 7px; font-size:.92rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.profile-post-body p { margin:0; color:var(--color-muted); font-size:.73rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.profile-empty { border:1px dashed var(--color-border-strong); border-radius:12px; padding:28px; text-align:center; }
.profile-empty p { margin:7px 0 0; color:var(--color-muted); font-size:.83rem; }
.profile-edit-card { margin:28px 0 0; }
.profile-photo-field { display:flex; align-items:center; gap:18px; padding-bottom:20px; margin-bottom:20px; border-bottom:1px solid var(--color-border); }
.profile-photo-field label { flex:1; margin:0; }
.profile-photo-field small { display:block; margin-top:7px; color:var(--color-muted); font-weight:400; }
.profile-form-grid { display:grid; grid-template-columns:1fr 1fr; gap:0 16px; }
.profile-edit-form input:disabled { background:#f7f7f7; color:#777; cursor:not-allowed; }
.password-confirm-box { display:grid; grid-template-columns:1fr 1fr; gap:20px; align-items:end; background:#fafafa; border:1px solid var(--color-border); border-radius:12px; padding:16px; margin:4px 0 18px; }
.password-confirm-box strong { font-size:.88rem; }
.password-confirm-box p { margin:5px 0 0; color:var(--color-muted); font-size:.76rem; }
.password-confirm-box label { margin:0; }
.profile-inline-link { color:inherit; text-decoration:underline; text-decoration-color:#ccc; text-underline-offset:3px; }
.profile-inline-link:hover { text-decoration-color:#111; }
.empty-state { text-align:center; padding:80px 20px; }
.empty-state h1 { margin:0 0 8px; }
.empty-state p { color:var(--color-muted); }

@media (max-width: 820px) {
    .profile-layout { grid-template-columns:1fr; }
    .profile-post-grid { grid-template-columns:1fr; }
    .profile-about-card { order:0; }
}
@media (max-width: 620px) {
    .profile-hero { align-items:flex-start; flex-direction:column; }
    .profile-name-line h1 { font-size:1.65rem; }
    .profile-avatar { width:76px; height:76px; }
    .profile-stats { grid-template-columns:1fr 1fr; }
    .profile-stats div:nth-child(2) { border-right:0; }
    .profile-stats div:nth-child(-n+2) { border-bottom:1px solid var(--color-border); }
    .profile-form-grid, .password-confirm-box { grid-template-columns:1fr; }
    .section-heading { flex-direction:column; gap:6px; }
}
